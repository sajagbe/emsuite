# Run with: emsuite -c coupled.in

molecule = 'ligand.xyz'            # the molecule the tuning step computes
pdb = 'complex.pdb'                # whole system, protonated, same frame as the .surf
surface_file = 'ligand.surf'       # make it with: emsuite -s surface.in
output_surf = 'coupled.surf'
potential_method = 'apbs'
potential_quantity = 'charge'

# The potential step takes the same keys as potential.in (see that template):
# forcefield, add_hydrogens, ph, unknown_charge, unknown_spin, unknown_method,
# unknown_basis, resp_copies, off, removed, pdie, sdie, grid_spacing.
off = ['LIG']                      # the tuned molecule: charge 0, radius kept

# Reuse an already-produced potential .surf instead of recomputing the potential.
# When set, pdb and the potential keys above are not used.
# potential_surf = 'precomputed.surf'

properties = ['homo', 'lumo', 'gap']
basis_set = 'sto-3g'
method = 'dft'
functional = 'b3lyp'
charge = 0
spin = 0
solvent = None
calc_type = 'separate'
parallel = False
